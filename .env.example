# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://codecarf:replace-with-local-db-password@localhost:5432/codecarf?schema=public"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
GRADER_ADAPTER="mock"
JUDGE0_URL="http://localhost:2358"
SEED_PASSWORD="LocalDev123!"
POSTGRES_PASSWORD="replace-with-local-db-password"
# Host port for the db container. Change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT="5432"
JUDGE0_POSTGRES_PASSWORD="replace-with-judge0-db-password"
JUDGE0_REDIS_PASSWORD="replace-with-judge0-redis-password"
JUDGE0_SECRET_KEY="replace-with-a-long-random-judge0-secret"
# Optional: seed demo progress for your own account (local only, keep real values out of git).
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
DEMO_USER_NAME=""
# Private file storage for teacher evidence and handwritten answer images. "local" writes to STORAGE_DIR (dev);
# "supabase" uses one private bucket for both (files are only served through authorized routes).
STORAGE_DRIVER="local"
STORAGE_DIR=".storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="teacher-documents"
# Shared secret for protected cron endpoints (e.g. POST /api/cron/contest-reminders).
CRON_SECRET="replace-with-a-random-cron-secret"
