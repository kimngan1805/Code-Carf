generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  STUDENT
  TEACHER
  ADMIN
  GRADER
  /// Đã nộp hồ sơ giảng viên, chờ admin duyệt; chưa có quyền học hay dạy.
  GUEST
}

/// Trạng thái một mục trong kho tài liệu: nháp, sẵn sàng dùng, hoặc cất đi mà không xóa.
enum LibraryStatus {
  DRAFT
  READY
  ARCHIVED
}

/// Ai thấy một mục trong kho: chỉ người tạo, hay mọi giảng viên.
enum LibraryVisibility {
  PRIVATE
  SHARED
}

/// Loại bài giảng trong kho.
enum LectureKind {
  VIDEO
  PDF
  SLIDE
  DOC
}

enum ExerciseKind {
  CODE
  HANDWRITTEN
  /// Trắc nghiệm: chấm tự động theo đáp án của từng câu (QuizQuestion).
  QUIZ
}

enum ExerciseReportKind {
  STATEMENT
  TEST_CASE
  AMBIGUOUS
}

enum ExerciseReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  NEW_LESSON
  CONTEST_UPCOMING
  SUBMISSION_RESULT
  REPORT_RESOLVED
}

/// PENDING: chờ chấm. RUNNING: đang chạy test case. NEEDS_REVIEW: bài viết tay AI đã chấm sơ bộ, chờ grader duyệt.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
  ERROR
}

enum ContestStatus {
  DRAFT
  PUBLISHED
  FINISHED
}

enum XpSource {
  ROOM_COMPLETED
  CONTEST_RESULT
  BADGE
  STREAK_BONUS
  ADMIN_ADJUSTMENT
}

/// Trình độ học viên tự đánh giá khi onboarding.
enum SkillLevel {
  BEGINNER
  BASIC
  INTERMEDIATE
}

enum LearningGoal {
  FUNDAMENTALS
  ALGORITHMS
  CONTESTS
  WEB
}

/// Cấp giảng dạy được nhận hồ sơ giảng viên (từ THPT trở lên).
enum TeachingLevel {
  HIGH_SCHOOL
  COLLEGE
  UNIVERSITY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProctoringEventType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  PASTE
  FACE_MISSING
  FACE_MISMATCH
  MULTIPLE_FACES
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  roleId               String
  role                 Role                 @relation(fields: [roleId], references: [id])
  /// Tổng XP, cache của XpEvent. Cấp độ được tính từ xp trong code, không lưu.
  xp                   Int                  @default(0)
  currentStreak        Int                  @default(0)
  longestStreak        Int                  @default(0)
  /// Ngày học gần nhất, dùng để tính chuỗi ngày học liên tục.
  lastActiveOn         DateTime?            @db.Date
  /// Thời điểm hoàn tất câu hỏi làm quen sau đăng ký; null thì cần làm onboarding.
  onboardedAt          DateTime?
  createdAt            DateTime             @default(now())
  learnerProfile       LearnerProfile?
  teacherApplications  TeacherApplication[] @relation("TeacherApplicant")
  reviewedApplications TeacherApplication[] @relation("TeacherApplicationReviewer")
  paths                Path[]               @relation("PathCreator")
  createdContests      Contest[]            @relation("ContestCreator")
  enrollments          Enrollment[]
  roomProgress         RoomProgress[]
  submissions          Submission[]         @relation("SubmissionAuthor")
  reviewedSubmissions  Submission[]         @relation("SubmissionReviewer")
  xpEvents             XpEvent[]
  badges               UserBadge[]
  assignedContests     ContestGrader[]
  contestEntries       ContestParticipant[]
  proctoringEvents     ProctoringEvent[]
  exerciseReports      ExerciseReport[]
  handledReports       ExerciseReport[]     @relation("ReportHandler")
  notifications        Notification[]
  passwordResetToken   PasswordResetToken?
  createdExercises     Exercise[]           @relation("ExerciseCreator")
  libraryLectures      LibraryLecture[]
  libraryCategories    LibraryCategory[]

  @@index([xp])
}

model PasswordResetToken {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  passwordDigest String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model PasswordResetRateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Danh mục trường để giảng viên chọn khi nộp hồ sơ.
model School {
  id           String               @id @default(cuid())
  name         String
  /// Tên tỉnh/thành theo danh sách 34 đơn vị (src/features/teacher-application/provinces.ts).
  province     String
  level        TeachingLevel
  applications TeacherApplication[]

  @@unique([province, name])
  @@index([province, level])
}

/// Hồ sơ xin quyền giảng viên, admin duyệt rồi mới đổi role.
model TeacherApplication {
  id            String                       @id @default(cuid())
  userId        String
  user          User                         @relation("TeacherApplicant", fields: [userId], references: [id], onDelete: Cascade)
  teachingLevel TeachingLevel
  province      String
  schoolId      String?
  school        School?                      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  /// Tên trường lúc nộp (chọn từ danh sách hoặc tự nhập khi không có).
  schoolName    String
  status        ApplicationStatus            @default(PENDING)
  reviewerId    String?
  reviewer      User?                        @relation("TeacherApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  documents     TeacherApplicationDocument[]
  createdAt     DateTime                     @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

/// File minh chứng; nội dung nằm ở kho lưu trữ riêng, không public.
model TeacherApplicationDocument {
  id            String             @id @default(cuid())
  applicationId String
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  size          Int
  storageKey    String             @unique
  createdAt     DateTime           @default(now())
}

/// Câu trả lời onboarding của học viên, dùng để gợi ý lộ trình.
model LearnerProfile {
  userId       String       @id
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  level        SkillLevel
  goal         LearningGoal
  languages    String[]
  dailyMinutes Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Path {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  description      String       @default("")
  published        Boolean      @default(false)
  sequentialUnlock Boolean      @default(true)
  /// Độ khó tổng thể, hiện trên thẻ lộ trình ở trang cộng đồng.
  difficulty       Difficulty   @default(EASY)
  /// Chủ đề ngắn (tối đa 5), dùng để lọc và hiện trên thẻ.
  tags             String[]     @default([])
  /// Thời lượng ước tính để hoàn thành, tính bằng phút; null khi giảng viên chưa nhập.
  estimatedMinutes Int?
  /// Khóa giao diện ảnh bìa có sẵn (không upload ảnh), xem src/features/paths/cover-themes.ts.
  coverTheme       String       @default("blue")
  /// Lúc xuất bản gần nhất; null khi còn là bản nháp.
  publishedAt      DateTime?
  /// Thời điểm xóa mềm; null khi lộ trình đang hoạt động.
  deletedAt        DateTime?
  creatorId        String
  creator          User         @relation("PathCreator", fields: [creatorId], references: [id])
  rooms            Room[]
  enrollments      Enrollment[]
  xpEvents         XpEvent[]
  createdAt        DateTime     @default(now())

  @@index([deletedAt, published])
  @@index([creatorId, deletedAt])
}

model Room {
  id                  String           @id @default(cuid())
  pathId              String
  path                Path             @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title               String
  description         String           @default("")
  /// Phần lý thuyết của bài học, dạng Markdown.
  content             String           @default("")
  published           Boolean          @default(false)
  /// Thứ tự trong path; room position N mở khóa khi đã xong room trước đó.
  position            Int
  xpReward            Int              @default(50)
  /// Video YouTube trong nội dung đã được đưa vào kho của giảng viên (quét một lần).
  libraryVideosSynced Boolean          @default(false)
  exercises           Exercise[]
  progress            RoomProgress[]
  xpEvents            XpEvent[]
  exerciseReports     ExerciseReport[]
  attachments         RoomAttachment[]

  @@unique([pathId, position])
  @@index([pathId, published, position])
}

/// Tài liệu bài giảng (PDF, PPTX, DOCX) giảng viên đính kèm vào bài học.
/// File nằm trong storage private, chỉ phục vụ qua route có kiểm tra quyền.
model RoomAttachment {
  id            String          @id @default(cuid())
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Tên file gốc (đã làm sạch) để hiển thị và đặt tên khi tải về.
  fileName      String
  /// MIME chuẩn theo loại file đã kiểm tra, không lấy từ trình duyệt.
  contentType   String
  size          Int
  storageKey    String          @unique
  position      Int
  createdAt     DateTime        @default(now())
  /// File trong kho mà tài liệu này được chép từ đó (bản lưu trữ riêng, không dùng chung).
  libraryFileId String?
  libraryFile   LibraryLecture? @relation(fields: [libraryFileId], references: [id], onDelete: SetNull)
  /// File đã được chép vào kho (một lần), kể cả khi bản trong kho đã bị xóa sau đó.
  librarySynced Boolean         @default(false)

  @@index([roomId, position])
}

/// Bài giảng trong kho tài liệu của giảng viên: video YouTube hoặc file (PDF, PPTX, DOCX).
/// Đưa file vào bài học là chép thành một RoomAttachment có bản lưu trữ riêng.
model LibraryLecture {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        LectureKind       @default(PDF)
  /// Tên hiển thị; với file mặc định là tên file.
  title       String            @default("")
  /// Mã video YouTube (11 ký tự) khi kind = VIDEO.
  youtubeId   String?
  fileName    String?
  contentType String?
  size        Int?
  storageKey  String?           @unique
  categoryId  String?
  category    LibraryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String[]          @default([])
  status      LibraryStatus     @default(READY)
  visibility  LibraryVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now())
  attachments RoomAttachment[]

  @@index([ownerId, createdAt])
  @@index([visibility, status])
  @@map("LibraryFile")
}

/// Danh mục do giảng viên tự đặt để xếp bài tập và bài giảng trong kho (ví dụ "Python", "CTDL").
model LibraryCategory {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  exercises Exercise[]
  lectures  LibraryLecture[]

  @@unique([ownerId, name])
}

/// Một dòng = người học đã hoàn thành room, dùng cho mở khóa tuần tự.
model RoomProgress {
  userId      String
  roomId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, roomId])
  @@index([roomId])
}

/// Bài tập dùng cho room luyện tập; cũng có thể đưa vào nhiều contest qua ContestExercise.
model Exercise {
  id                String            @id @default(cuid())
  roomId            String?
  room              Room?             @relation(fields: [roomId], references: [id])
  title             String
  prompt            String
  kind              ExerciseKind      @default(CODE)
  difficulty        Difficulty        @default(EASY)
  points            Int               @default(100)
  timeLimitMs       Int               @default(2000)
  memoryLimitKb     Int               @default(262144)
  /// Đáp án mẫu / tiêu chí chấm cho bài viết tay, dùng cho AI và grader.
  rubric            String?
  /// Giảng viên tạo bài; null với bài cũ của cuộc thi. Bài có creatorId và không có sourceId hiện trong kho tài liệu.
  creatorId         String?
  creator           User?             @relation("ExerciseCreator", fields: [creatorId], references: [id])
  /// Bài gốc trong kho khi bài này được chép vào một bài học; bản chép không hiện lại trong kho.
  sourceId          String?
  source            Exercise?         @relation("ExerciseCopies", fields: [sourceId], references: [id], onDelete: SetNull)
  copies            Exercise[]        @relation("ExerciseCopies")
  createdAt         DateTime          @default(now())
  /// Các trường dưới đây chỉ dùng cho bài trong kho tài liệu (roomId null).
  libraryCategoryId String?
  libraryCategory   LibraryCategory?  @relation(fields: [libraryCategoryId], references: [id], onDelete: SetNull)
  libraryTags       String[]          @default([])
  libraryStatus     LibraryStatus     @default(READY)
  libraryVisibility LibraryVisibility @default(PRIVATE)
  /// Bài trong bài học đã có bản trong kho (chép đúng một lần, xóa bản trong kho không chép lại).
  librarySynced     Boolean           @default(false)
  /// Thứ tự trong bài học (nhỏ hiện trước).
  position          Int               @default(0)
  testCases         TestCase[]
  quizQuestions     QuizQuestion[]
  submissions       Submission[]
  contests          ContestExercise[]
  contestDrafts     ContestDraft[]
  reports           ExerciseReport[]

  @@index([creatorId, sourceId])
  @@index([roomId, position])
}

model ExerciseReport {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind        ExerciseReportKind
  description String               @db.VarChar(2000)
  createdAt   DateTime             @default(now())
  status      ExerciseReportStatus @default(NEW)
  resolution  String?              @db.VarChar(2000)
  resolvedAt  DateTime?
  handlerId   String?
  handler     User?                @relation("ReportHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  version     Int                  @default(0)
  updatedAt   DateTime             @default(now()) @updatedAt

  @@index([roomId, status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, exerciseId, createdAt])
  @@index([exerciseId, createdAt])
  @@index([roomId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

/// Một câu hỏi của bài trắc nghiệm (Exercise.kind = QUIZ), chọn một đáp án đúng.
model QuizQuestion {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Thứ tự hiển thị, bắt đầu từ 0.
  position    Int
  prompt      String
  options     String[]
  /// Vị trí đáp án đúng trong `options`.
  answer      Int
  /// Giải thích hiện cho học viên sau khi nộp.
  explanation String   @default("")

  @@unique([exerciseId, position])
}

model TestCase {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  input      String
  expected   String
  isHidden   Boolean  @default(true)
  weight     Int      @default(1)
}

model Submission {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation("SubmissionAuthor", fields: [userId], references: [id])
  exerciseId       String
  exercise         Exercise         @relation(fields: [exerciseId], references: [id])
  /// Null khi nộp ở chế độ học; có giá trị khi nộp trong cuộc thi.
  contestId        String?
  contest          Contest?         @relation(fields: [contestId], references: [id])
  /// Mã nguồn (bài CODE). Null với bài viết tay.
  source           String?
  language         String?
  /// Ảnh bài viết tay đã upload (bài HANDWRITTEN).
  imageUrl         String?
  /// Đáp án đã chọn theo thứ tự câu hỏi (bài QUIZ); -1 là bỏ trống.
  quizAnswers      Int[]            @default([])
  status           SubmissionStatus @default(PENDING)
  score            Int?
  feedback         String?
  runtimeMs        Int?
  memoryKb         Int?
  /// Điểm và nhận xét AI đề xuất cho bài viết tay, trước khi grader duyệt.
  aiScore          Int?
  aiFeedback       String?
  reviewerId       String?
  reviewer         User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  autoSubmitted    Boolean          @default(false)
  flaggedForReview Boolean          @default(false)
  finalizedDraft   ContestDraft?    @relation("ContestFinalSubmission")

  @@index([userId, exerciseId])
  @@index([contestId, createdAt])
  @@index([status])
}

/// Sổ ghi XP, cho phép xếp hạng theo path và theo tuần. User.xp là tổng cộng dồn.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    XpSource
  pathId    String?
  path      Path?    @relation(fields: [pathId], references: [id], onDelete: SetNull)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pathId, userId])
  @@index([createdAt])
}

model Contest {
  id                 String               @id @default(cuid())
  slug               String               @unique
  title              String
  description        String               @default("")
  status             ContestStatus        @default(DRAFT)
  creatorId          String?
  creator            User?                @relation("ContestCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  /// Registration opens; not the start of a timed attempt.
  startsAt           DateTime?
  /// Registration closes; does not end active attempts.
  endsAt             DateTime?
  /// Shared window in which registered students may start and submit.
  examStartsAt       DateTime?
  examEndsAt         DateTime?
  /// Duration counted separately from each participant's explicit start.
  durationMinutes    Int                  @default(60)
  /// Phạt (phút) cho mỗi lần nộp sai, dùng khi xếp hạng.
  penaltyMinutes     Int                  @default(20)
  requireFaceCheck   Boolean              @default(false)
  violationThreshold Int                  @default(3)
  exercises          ContestExercise[]
  graders            ContestGrader[]
  participants       ContestParticipant[]
  submissions        Submission[]
  xpEvents           XpEvent[]
  proctoringEvents   ProctoringEvent[]
  createdAt          DateTime             @default(now())
}

model ContestExercise {
  contestId  String
  exerciseId String
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Thứ tự đề: A, B, C... hiển thị theo position.
  position   Int
  /// Ghi đè Exercise.points trong cuộc thi này, nếu có.
  points     Int?

  @@id([contestId, exerciseId])
  @@unique([contestId, position])
}

model ContestGrader {
  contestId  String
  graderId   String
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  grader     User     @relation(fields: [graderId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([contestId, graderId])
}

/// Thí sinh tham gia một cuộc thi; score/penalty được cập nhật khi chấm để xếp hạng nhanh.
model ContestParticipant {
  contestId        String
  userId           String
  contest          Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt         DateTime      @default(now())
  startedAt        DateTime?
  deadlineAt       DateTime?
  finishedAt       DateTime?
  score            Int           @default(0)
  penaltyMinutes   Int           @default(0)
  /// Ảnh khuôn mặt tham chiếu chụp lúc vào thi, dùng để so khớp.
  faceReferenceUrl String?
  faceVerifiedAt   DateTime?
  violationCount   Int           @default(0)
  flaggedAt        DateTime?
  draft            ContestDraft?

  @@id([contestId, userId])
  @@index([contestId, score(sort: Desc), penaltyMinutes])
  @@index([contestId, flaggedAt])
}

/// Last active editor snapshot accepted before the contest deadline.
model ContestDraft {
  contestId         String
  userId            String
  participant       ContestParticipant @relation(fields: [contestId, userId], references: [contestId, userId], onDelete: Cascade)
  exerciseId        String?
  exercise          Exercise?          @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  source            String             @default("")
  language          String             @default("python")
  savedAt           DateTime           @default(now())
  finalSubmissionId String?            @unique
  finalSubmission   Submission?        @relation("ContestFinalSubmission", fields: [finalSubmissionId], references: [id], onDelete: SetNull)

  @@id([contestId, userId])
}

model ProctoringEvent {
  id            String              @id @default(cuid())
  clientEventId String?
  contestId     String
  userId        String
  contest       Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ProctoringEventType
  /// Chi tiết tùy loại: độ dài đoạn dán, độ tương đồng khuôn mặt...
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@unique([contestId, userId, clientEventId])
  @@index([contestId, userId, createdAt])
}

model Enrollment {
  userId     String
  pathId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path       Path     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@id([userId, pathId])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  users       UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}
